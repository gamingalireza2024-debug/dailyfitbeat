{
  "redirects": [
    { "source": "/mealplan.html", "destination": "/planner.html", "permanent": true }
  ],
  "rewrites": [
    { "source": "/recipes/:slug", "destination": "/recipe.html?slug=:slug" },
    { "source": "/recipes", "destination": "/recipes.html" },
    { "source": "/planner", "destination": "/planner.html" },
    { "source": "/market", "destination": "/market.html" },
    { "source": "/pro", "destination": "/pro.html" },
    { "source": "/ai", "destination": "/ai.html" },
    { "source": "/about", "destination": "/about.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" }
      ]
    }
  ]
}
